# Public frontend API address. No secrets in EXPO_PUBLIC_*.
EXPO_PUBLIC_API_URL=http://localhost:3001
# Backend defaults bind only to this PC. LAN testing requires explicit configuration.
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_PATH=.data/development.sqlite
# Cloud API only: configure the PostgreSQL URL in the hosting secret settings.
# When DATABASE_URL is set, DATABASE_PATH is ignored; no local data is imported.
# DATABASE_URL=postgresql://user:password@host:5432/database
# Render supplies PORT. Production requires DATABASE_URL.
ALLOW_REGISTRATION=0
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Local mail is written to ignored files; it does not send real email.
MAIL_MODE=local
MAIL_OUTBOX_DIR=.data/mail-outbox
# Legacy development links only; App codes do not require PUBLIC_APP_URL.
REQUIRE_VERIFIED_EMAIL=0
# Production: NODE_ENV=production, DATABASE_URL, MAIL_MODE=gmail or resend.
# Production always requires email verification, regardless of the development flag.
# MAIL_FROM=Qianmai <no-reply@your-domain.example>
# RESEND_API_KEY=configure-secret-on-server

# Administrator initialization (no initial password):
# BOOTSTRAP_ADMIN_EMAIL=owner@example.com
# BOOTSTRAP_ADMIN_NAME=Owner

# No-domain mail option; use a host allowing outbound SMTP (Render paid API).
# MAIL_MODE=gmail
# GMAIL_USER=your-sender@gmail.com
# GMAIL_APP_PASSWORD=Google-generated-app-password-not-login-password
