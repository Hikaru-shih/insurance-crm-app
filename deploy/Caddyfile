{$DOMAIN} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    X-Frame-Options DENY
  }
  handle /api/* {
    reverse_proxy api:3001
  }
  handle {
    root * /srv
    try_files {path} /index.html
    header /index.html Cache-Control "no-cache"
    file_server
  }
}
