# Public frontend API address. No secrets in EXPO_PUBLIC_*.
EXPO_PUBLIC_API_URL=http://localhost:3001
# Backend defaults bind only to this PC. LAN testing requires explicit configuration.
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_PATH=.data/development.sqlite
ALLOW_REGISTRATION=0
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
